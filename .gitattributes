# Normalize text files to LF in the repo; checkout uses the platform default.
* text=auto

# Shell scripts must stay LF (gradlew breaks on Linux/CI with CRLF).
gradlew text eol=lf
*.sh    text eol=lf

# Windows batch files need CRLF.
*.bat   text eol=crlf

# Binaries
*.jar   binary
*.dll   binary
*.webp  binary
*.png   binary
