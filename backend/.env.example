DASH_USER=changeme
DASH_PASS=changeme
MQTT_USER=changeme
MQTT_PASS=changeme
# Optional: DEBUG, INFO (default), WARNING, ERROR
LOG_LEVEL=INFO
# Optional: API listen address and port (default 127.0.0.1:5000, behind nginx)
#BIND_HOST=127.0.0.1
#PORT=5000
# Optional: TLS certificates the watchdog checks for expiry (#206), host:port, comma-separated
#CERT_CHECK=www.example.com:443,example.com:8883
# Optional: location for the outdoor weather (Open-Meteo, #245); 2 decimals (~1 km) is plenty
#WEATHER_LAT=47.00
#WEATHER_LON=19.00
