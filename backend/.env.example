DASH_USER=changeme
DASH_PASS=changeme
MQTT_USER=changeme
MQTT_PASS=changeme
# Optional: DEBUG, INFO (default), WARNING, ERROR
LOG_LEVEL=INFO
# Optional: API listen address and port (default 127.0.0.1:5000, behind nginx)
#BIND_HOST=127.0.0.1
#PORT=5000
# Optional: TLS certificates the watchdog checks for expiry (#206), host:port, comma-separated
#CERT_CHECK=www.example.com:443,example.com:8883
# Optional: location for the outdoor weather (Open-Meteo, #245); 2 decimals (~1 km) is plenty
#WEATHER_LAT=47.00
#WEATHER_LON=19.00
# Optional: off-site backup to S3 (#122, README "Backups"); no bucket = local backups only.
# The key belongs to an IAM user that may only s3:PutObject into the bucket's backups/ prefix.
#BACKUP_S3_BUCKET=homeping-backup-example
#BACKUP_S3_PREFIX=backups/
#AWS_ACCESS_KEY_ID=AKIAEXAMPLEEXAMPLE00
#AWS_SECRET_ACCESS_KEY=example-not-a-real-secret
#AWS_DEFAULT_REGION=eu-central-1
# Optional: bearer token for Prometheus at GET /api/metrics; empty = no endpoint (404).
# Make a long random one: python -c "import secrets; print(secrets.token_urlsafe(32))"
#METRICS_TOKEN=example-not-a-real-token
