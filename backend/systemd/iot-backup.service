# Nightly data.db backup (#78). Install: see the "Backups" section in README.md.
# Runs as the backend's user from /opt/iot (#59).
[Unit]
Description=Back up the IoT backend database

[Service]
Type=oneshot
User=iot
Group=iot
WorkingDirectory=/opt/iot
ExecStart=/opt/iot/venv/bin/python backup_db.py --keep 7
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/iot
ProtectHome=true
PrivateTmp=true
