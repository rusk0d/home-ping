# Backend service (#59): runs as the unprivileged user "iot" from /opt/iot with its own
# venv, served by waitress on 127.0.0.1:5000 behind nginx. Install: README "Production setup".
[Unit]
Description=Home Ping backend (MQTT ingest, alerts, REST API)
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
User=iot
Group=iot
WorkingDirectory=/opt/iot
ExecStart=/opt/iot/venv/bin/python server.py
Restart=on-failure
RestartSec=5
# Quiet hours, "today", the weekly push and the baseline's hour of day are local time: say
# which, so a rebuilt host left on UTC doesn't shift them
Environment=TZ=Europe/Budapest

# Hardening: the process can only write to its own directory
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/iot
# New files (data.db, its -wal/-shm, backups) only for iot (#169)
UMask=0077
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# What a network service that only reads and writes its own files never needs: no
# capabilities, only IP and Unix sockets, the usual system calls of a service without the
# privileged ones, no writable-and-executable memory, no view of other processes or users.
# Check after a change: systemd-analyze security iot-backend
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
MemoryDenyWriteExecute=true
ProtectProc=invisible
ProcSubset=pid
ProtectClock=true
ProtectKernelLogs=true
ProtectHostname=true
PrivateUsers=true
RemoveIPC=true
# It runs at about 40-50 MB; a leak gets the service restarted, not the server out of memory
MemoryMax=300M

[Install]
WantedBy=multi-user.target
