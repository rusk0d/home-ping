<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Only this app (same signing key) may send broadcasts to the widget receiver;
         system broadcasts (widget updates, package replaced) always pass (#63) -->
    <permission
        android:name="${applicationId}.permission.UPDATE_WIDGET"
        android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.permission.UPDATE_WIDGET" />

    <!-- Internet permission for API calls -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Required for Android 13+ notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- Required for widget background updates on Android 12+ -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    
    <application
        android:name=".HomeEnvApp"   
        android:allowBackup="false"
        android:label="${appLabel}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HomeEnv">
        
        <!-- Main launcher activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Notification settings (#82), opened from the bell in the header -->
        <activity
            android:name=".NotificationSettingsActivity"
            android:exported="false" />
        
        <!-- Channel FCM uses when it shows a notification message itself (app in background) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="homeenv_channel" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/good" />

        <!-- Firebase Cloud Messaging service -->
        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        
        <!-- Widget receiver. Exported because the system's widget host calls it; the
             permission keeps other apps from triggering fetches. The 2-minute alarm
             uses an explicit intent, so its action needs no filter entry. -->
        <receiver
            android:name=".HomeEnvWidget"
            android:exported="true"
            android:permission="${applicationId}.permission.UPDATE_WIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info"/>
        </receiver>
        
    </application>
</manifest>