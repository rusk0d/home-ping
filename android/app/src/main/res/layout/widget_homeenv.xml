<?xml version="1.0" encoding="utf-8"?>
<!-- Widget, 4x2: temperature, humidity and occupancy with a gauge each, a CO2 row
     with one full-width gauge, and an online line. Filled in by HomeEnvWidget
     (gauges are bitmaps from WidgetGauge). -->
<!-- Lint (#121): a widget is RemoteViews, where AppCompat's app:tint doesn't work, so
     android:tint is right (UseAppTint); the empty FrameLayouts are the weighted spacers
     (UselessLeaf). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    tools:ignore="UseAppTint,UselessLeaf"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="6dp">

    <!-- Spacers (FrameLayout: widgets can't inflate plain View) keep the metrics near the top -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_metric_temp"
                android:drawablePadding="4dp"
                android:drawableTint="@color/accent_temp"
                android:gravity="center_vertical"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="TEMP"
                android:textColor="@color/muted"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/w_temp_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="@color/text"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:maxLines="1"
                    android:text="°C"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/w_temp_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text=" "
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/w_temp_gauge"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="6dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_metric_hum"
                android:drawablePadding="4dp"
                android:drawableTint="@color/accent_hum"
                android:gravity="center_vertical"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="HUMIDITY"
                android:textColor="@color/muted"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/w_hum_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="@color/text"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:maxLines="1"
                    android:text="%"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/w_hum_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text=" "
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/w_hum_gauge"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="6dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_metric_person"
                android:drawablePadding="4dp"
                android:drawableTint="@color/muted"
                android:gravity="center_vertical"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="OCCUPIED"
                android:textColor="@color/muted"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/w_occ_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="@color/text"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/w_occ_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text=" "
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/w_occ_gauge"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="6dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />
        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3" />

    <!-- CO2: one line of text, then a thinner gauge as wide as the three above -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_metric_co2"
            android:drawablePadding="4dp"
            android:drawableTint="@color/accent_co2"
            android:gravity="center_vertical"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="CO₂"
            android:textColor="@color/muted"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/w_co2_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="--"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:maxLines="1"
            android:text="ppm"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/w_co2_level"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:maxLines="1"
            android:text=" "
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/w_co2_gauge"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_online_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/dot"
            android:tint="@color/muted" />

        <TextView
            android:id="@+id/w_online"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="waiting…"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/w_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <!-- Refresh; a tap anywhere else opens the app -->
        <ImageView
            android:id="@+id/w_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="-6dp"
            android:contentDescription="Refresh"
            android:padding="6dp"
            android:src="@drawable/ic_refresh"
            android:tint="@color/muted" />
    </LinearLayout>
</LinearLayout>
