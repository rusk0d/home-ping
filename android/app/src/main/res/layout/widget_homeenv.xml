<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="0dp"
    android:clipToPadding="false"
    android:background="@drawable/widget_background">


    <!-- Temperature Cell -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="2dp">
        
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_temperature"
            android:contentDescription="Temperature"
            android:layout_marginBottom="2dp"/>
        
        <TextView
            android:id="@+id/widget_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--°C"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"/>
    </LinearLayout>

    <!-- Humidity Cell -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="2dp">
        
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_humidity"
            android:contentDescription="Humidity"
            android:layout_marginBottom="2dp"/>
        
        <TextView
            android:id="@+id/widget_humidity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--%"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"/>
    </LinearLayout>

    <!-- Occupancy Cell -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="2dp">
        
        <ImageView
            android:id="@+id/widget_occupancy_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_person"
            android:contentDescription="Occupancy"
            android:layout_marginBottom="2dp"/>
        
        <TextView
            android:id="@+id/widget_occupancy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"/>
    </LinearLayout>

    <!-- Confidence Cell -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="2dp">
        
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chart"
            android:contentDescription="Confidence"
            android:layout_marginBottom="2dp"/>
        
        <TextView
            android:id="@+id/widget_confidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--%"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"/>
    </LinearLayout>

    <!-- Online Status Cell -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="2dp">
        
        <ImageView
            android:id="@+id/widget_online_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_circle"
            android:contentDescription="Status"
            android:layout_marginBottom="2dp"/>
        
        <TextView
            android:id="@+id/widget_online"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Off"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"/>
    </LinearLayout>

</LinearLayout>