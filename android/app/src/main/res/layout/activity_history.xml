<?xml version="1.0" encoding="utf-8"?>
<!-- History screen (#82): 7 days from /api/hourly, 30 days / 12 months from /api/daily (#129) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen">

    <!-- Header: back arrow + title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="@color/text" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="History"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:textColor="@color/text"/>

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last 7 days, hourly averages"
                android:textSize="13sp"
                android:textColor="@color/muted"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Range: 7 days / 30 days / 12 months (#129); styled in HistoryActivity -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/range_week"
            style="@style/HistoryRange"
            android:text="7 days" />

        <TextView
            android:id="@+id/range_month"
            style="@style/HistoryRange"
            android:text="30 days" />

        <TextView
            android:id="@+id/range_year"
            style="@style/HistoryRange"
            android:text="12 months" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="32dp">

                <TextView
                    android:id="@+id/error"
                    style="@style/HomeFoot"
                    android:layout_marginBottom="12dp"
                    android:text="Can't reach the server"
                    android:textColor="@color/poor"
                    android:textSize="13sp"
                    android:visibility="gone" />

            <com.david.homeenv.ui.AccentCard
                style="@style/HomeCard"
                android:layout_marginTop="0dp"
                app:accentColor="@color/accent_temp">

                <TextView
                    style="@style/HomeLabel"
                    android:drawableStart="@drawable/ic_metric_temp"
                    android:drawableTint="@color/accent_temp"
                    android:text="Temperature" />

                <TextView
                    android:id="@+id/temp_summary"
                    style="@style/HomeFoot"
                    android:layout_marginTop="4dp"
                    android:text="--" />

                <com.david.homeenv.ui.HistoryChartView
                    android:id="@+id/temp_chart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:accentColor="@color/accent_temp" />
            </com.david.homeenv.ui.AccentCard>

            <com.david.homeenv.ui.AccentCard
                style="@style/HomeCard"
                android:layout_marginTop="12dp"
                app:accentColor="@color/accent_hum">

                <TextView
                    style="@style/HomeLabel"
                    android:drawableStart="@drawable/ic_metric_hum"
                    android:drawableTint="@color/accent_hum"
                    android:text="Humidity" />

                <TextView
                    android:id="@+id/humidity_summary"
                    style="@style/HomeFoot"
                    android:layout_marginTop="4dp"
                    android:text="--" />

                <com.david.homeenv.ui.HistoryChartView
                    android:id="@+id/humidity_chart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:accentColor="@color/accent_hum" />
            </com.david.homeenv.ui.AccentCard>

            <com.david.homeenv.ui.AccentCard
                style="@style/HomeCard"
                android:layout_marginTop="12dp"
                app:accentColor="@color/accent_co2">

                <TextView
                    style="@style/HomeLabel"
                    android:drawableStart="@drawable/ic_metric_co2"
                    android:drawableTint="@color/accent_co2"
                    android:text="CO₂" />

                <TextView
                    android:id="@+id/co2_summary"
                    style="@style/HomeFoot"
                    android:layout_marginTop="4dp"
                    android:text="--" />

                <com.david.homeenv.ui.HistoryChartView
                    android:id="@+id/co2_chart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:accentColor="@color/accent_co2" />
            </com.david.homeenv.ui.AccentCard>

            <com.david.homeenv.ui.AccentCard
                style="@style/HomeCard"
                android:layout_marginTop="12dp"
                app:accentColor="@color/accent_pres">

                <TextView
                    style="@style/HomeLabel"
                    android:drawableStart="@drawable/ic_metric_pres"
                    android:drawableTint="@color/accent_pres"
                    android:text="Pressure" />

                <TextView
                    android:id="@+id/pressure_summary"
                    style="@style/HomeFoot"
                    android:layout_marginTop="4dp"
                    android:text="--" />

                <com.david.homeenv.ui.HistoryChartView
                    android:id="@+id/pressure_chart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:accentColor="@color/accent_pres" />
            </com.david.homeenv.ui.AccentCard>

            <com.david.homeenv.ui.AccentCard
                style="@style/HomeCard"
                android:layout_marginTop="12dp"
                app:accentColor="@color/good">

                <TextView
                    style="@style/HomeLabel"
                    android:drawableStart="@drawable/ic_metric_person"
                    android:drawableTint="@color/good"
                    android:text="Occupied time per day" />

                <TextView
                    android:id="@+id/occupancy_summary"
                    style="@style/HomeFoot"
                    android:layout_marginTop="4dp"
                    android:text="--" />

                <com.david.homeenv.ui.HistoryChartView
                    android:id="@+id/occupancy_chart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:accentColor="@color/good" />
            </com.david.homeenv.ui.AccentCard>

            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
