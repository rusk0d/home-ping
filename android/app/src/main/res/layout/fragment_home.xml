<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen, styled after web/index.html (see #30) -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="32dp">

            <!-- Occupancy alerts (arm switch) -->
            <com.david.homeenv.ui.AccentCard
                style="@style/HomeCard"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/HomeLabel"
                        android:text="Occupancy alerts" />

                    <TextView
                        android:id="@+id/occupancyStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Loading…"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/occupancySwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </com.david.homeenv.ui.AccentCard>

            <!-- Row 1: temperature | humidity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.david.homeenv.ui.AccentCard
                    android:id="@+id/card_temp"
                    style="@style/HomeCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:accentColor="@color/accent_temp">

                    <TextView
                        style="@style/HomeLabel"
                        android:drawableStart="@drawable/ic_metric_temp"
                        android:drawableTint="@color/accent_temp"
                        android:text="Temperature" />

                    <TextView
                        android:id="@+id/temp_value"
                        style="@style/HomeValue"
                        android:text="--" />

                    <TextView
                        android:id="@+id/temp_chip"
                        style="@style/HomeChip" />

                    <TextView
                        android:id="@+id/temp_age"
                        style="@style/HomeFoot"
                        android:layout_marginTop="10dp"
                        android:text="waiting…" />
                </com.david.homeenv.ui.AccentCard>

                <com.david.homeenv.ui.AccentCard
                    android:id="@+id/card_hum"
                    style="@style/HomeCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:accentColor="@color/accent_hum">

                    <TextView
                        style="@style/HomeLabel"
                        android:drawableStart="@drawable/ic_metric_hum"
                        android:drawableTint="@color/accent_hum"
                        android:text="Humidity" />

                    <TextView
                        android:id="@+id/humidity_value"
                        style="@style/HomeValue"
                        android:text="--" />

                    <TextView
                        android:id="@+id/humidity_chip"
                        style="@style/HomeChip" />

                    <TextView
                        android:id="@+id/humidity_age"
                        style="@style/HomeFoot"
                        android:layout_marginTop="10dp"
                        android:text="waiting…" />
                </com.david.homeenv.ui.AccentCard>
            </LinearLayout>

            <!-- Row 2: pressure | occupied now -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.david.homeenv.ui.AccentCard
                    android:id="@+id/card_pres"
                    style="@style/HomeCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:accentColor="@color/accent_pres">

                    <TextView
                        style="@style/HomeLabel"
                        android:drawableStart="@drawable/ic_metric_pres"
                        android:drawableTint="@color/accent_pres"
                        android:text="Pressure" />

                    <TextView
                        android:id="@+id/pressure_value"
                        style="@style/HomeValue"
                        android:text="--" />

                    <TextView
                        android:id="@+id/pressure_chip"
                        style="@style/HomeChip" />

                    <TextView
                        android:id="@+id/pressure_trend"
                        style="@style/HomeFoot"
                        android:layout_marginTop="10dp"
                        android:text="3 h trend: --" />
                </com.david.homeenv.ui.AccentCard>

                <com.david.homeenv.ui.AccentCard
                    android:id="@+id/card_occ_now"
                    style="@style/HomeCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:accentColor="@color/faint">

                    <TextView
                        style="@style/HomeLabel"
                        android:drawableStart="@drawable/ic_metric_person"
                        android:drawableTint="@color/muted"
                        android:text="Occupied now" />

                    <TextView
                        android:id="@+id/occupied_value"
                        style="@style/HomeValue"
                        android:text="--" />

                    <TextView
                        android:id="@+id/occupied_chip"
                        style="@style/HomeChip" />

                    <TextView
                        android:id="@+id/confidence_value"
                        style="@style/HomeFoot"
                        android:layout_marginTop="10dp"
                        android:text="confidence --" />
                </com.david.homeenv.ui.AccentCard>
            </LinearLayout>

            <!-- CO2: full width so the gauge scale has room -->
            <com.david.homeenv.ui.AccentCard
                android:id="@+id/card_co2"
                style="@style/HomeCard"
                android:layout_marginTop="12dp"
                app:accentColor="@color/accent_co2">

                <TextView
                    style="@style/HomeLabel"
                    android:drawableStart="@drawable/ic_metric_co2"
                    android:drawableTint="@color/accent_co2"
                    android:text="CO₂" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/co2_value"
                        style="@style/HomeValue"
                        android:text="--" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="ppm"
                        android:textColor="@color/muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/co2_chip"
                    style="@style/HomeChip" />

                <com.david.homeenv.ui.Co2GaugeView
                    android:id="@+id/co2_gauge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/co2_sensor_status"
                        style="@style/HomeFoot"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="sensor --" />

                    <TextView
                        android:id="@+id/co2_age"
                        style="@style/HomeFoot"
                        android:text="waiting…" />
                </LinearLayout>
            </com.david.homeenv.ui.AccentCard>

            <!-- Occupancy today: 24 hourly bars -->
            <com.david.homeenv.ui.AccentCard
                android:id="@+id/card_occ"
                style="@style/HomeCard"
                android:layout_marginTop="12dp"
                app:accentColor="@color/good">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/HomeLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_metric_person"
                        android:drawableTint="@color/good"
                        android:text="Occupancy today" />

                    <TextView
                        android:id="@+id/occ_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.david.homeenv.ui.OccupancyBarsView
                    android:id="@+id/occupancy_bars"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/occ_legend"
                    style="@style/HomeFoot"
                    android:layout_marginTop="8dp" />
            </com.david.homeenv.ui.AccentCard>

            <!-- Devices -->
            <TextView
                style="@style/HomeSection"
                android:text="Devices" />

            <LinearLayout
                android:id="@+id/devices_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/restarts_value"
                style="@style/HomeFoot"
                android:layout_marginTop="8dp"
                android:layout_marginStart="4dp"
                android:text="Restarts: --" />

            <!-- Last 24 hours -->
            <TextView
                style="@style/HomeSection"
                android:text="Last 24 hours" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.david.homeenv.ui.AccentCard
                    style="@style/HomeCard"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp">

                    <TextView style="@style/HomeLabel" android:text="Avg temp" />

                    <TextView
                        android:id="@+id/stats_avg_temp"
                        style="@style/HomeValue"
                        android:textSize="20sp"
                        android:text="--" />
                </com.david.homeenv.ui.AccentCard>

                <com.david.homeenv.ui.AccentCard
                    style="@style/HomeCard"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp">

                    <TextView style="@style/HomeLabel" android:text="Avg humidity" />

                    <TextView
                        android:id="@+id/stats_avg_humidity"
                        style="@style/HomeValue"
                        android:textSize="20sp"
                        android:text="--" />
                </com.david.homeenv.ui.AccentCard>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.david.homeenv.ui.AccentCard
                    style="@style/HomeCard"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp">

                    <TextView style="@style/HomeLabel" android:text="Avg confidence" />

                    <TextView
                        android:id="@+id/stats_avg_confidence"
                        style="@style/HomeValue"
                        android:textSize="20sp"
                        android:text="--" />
                </com.david.homeenv.ui.AccentCard>

                <com.david.homeenv.ui.AccentCard
                    style="@style/HomeCard"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp">

                    <TextView style="@style/HomeLabel" android:text="Occupied time" />

                    <TextView
                        android:id="@+id/stats_occupied_hours"
                        style="@style/HomeValue"
                        android:textSize="20sp"
                        android:text="--" />
                </com.david.homeenv.ui.AccentCard>
            </LinearLayout>

            <!-- Recent readings -->
            <TextView
                style="@style/HomeSection"
                android:text="Recent readings" />

            <com.david.homeenv.ui.AccentCard
                style="@style/HomeCard"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <TableLayout
                        android:id="@+id/readings_table"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                </HorizontalScrollView>
            </com.david.homeenv.ui.AccentCard>

        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
