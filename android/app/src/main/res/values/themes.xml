<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HomeEnv" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color (dark theme) -->
        <item name="colorPrimary">@color/dark_primary</item>
        <item name="colorPrimaryVariant">@color/dark_background</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/dark_primary</item>
        <item name="colorSecondaryVariant">@color/dark_secondary</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:navigationBarColor">@color/dark_background</item>
        
        <!-- Background colors -->
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        
        <!-- Switch colors -->
        <item name="colorControlActivated">@color/status_online</item>
        <item name="colorSwitchThumbNormal">@color/text_secondary</item>
        
        <!-- Action bar -->
        <item name="actionBarStyle">@style/ActionBar.HomeEnv</item>
    </style>
    
    <style name="ActionBar.HomeEnv" parent="Widget.MaterialComponents.ActionBar.Primary">
        <item name="background">@color/dark_background</item>
        <item name="titleTextStyle">@style/ActionBarTitle</item>
    </style>
    
    <style name="ActionBarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>